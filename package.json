{
  "name": "tastearr",
  "version": "0.6.0",
  "private": true,
  "description": "Learns your anime taste and recommends next season's shows for Sonarr.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "eval": "node --no-warnings=ExperimentalWarning dist/server/eval.js",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.js --max-warnings 0 . && node tools/lint/node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node tools/lint/node_modules/prettier/bin/prettier.cjs --write .",
    "depcheck": "node tools/lint/node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config tools/lint/dependency-cruiser.cjs server shared web/src test",
    "tools:install": "npm ci --prefix tools/lint --no-audit --no-fund"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
